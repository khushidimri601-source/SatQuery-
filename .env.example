PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# JWT_SECRET must be explicitly set; the server refuses weak/missing secrets.
#
ALLOWED_ORIGIN=http://localhost:3000
DB_PATH=./satquery.db
# Real Prithvi-EO-2.0 backbone path for six-band HLS-style GeoTIFFs.
# Keep false for a lightweight RGB-only demo.
SATQUERY_PRITHVI_ENABLED=false
SATQUERY_PRITHVI_MODEL=prithvi_eo_v2_300
